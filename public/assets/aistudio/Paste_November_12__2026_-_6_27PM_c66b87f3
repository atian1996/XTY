## 十四、关键代码骨架（可直接扩展）

### 14.1 主场景初始化

```js
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';

export class CyberRangeScene {
  constructor(canvas) {
    this.canvas = canvas;
    this.scene = new THREE.Scene();
    this.scene.background = new THREE.Color(0x0a0e17);
    this.scene.fog = new THREE.FogExp2(0x0a0e17, 0.012);

    this.camera = new THREE.PerspectiveCamera(
      42, canvas.clientWidth / canvas.clientHeight, 0.1, 400
    );
    this.camera.position.set(0, 26, 38);

    this.renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: false });
    this.renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    this.renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
    this.renderer.toneMappingExposure = 1.05;
    this.renderer.outputColorSpace = THREE.SRGBColorSpace;

    this.controls = new OrbitControls(this.camera, canvas);
    // ... 参数见 10.1

    this.composer = new EffectComposer(this.renderer);
    // ... 后处理链见 11.1

    this.sharedUniforms = { uTime: { value: 0 } };

    this._build();
    this._bindEvents();
    this._startLoop();
  }

  _build() {
    this.ground = new GroundDisc().build();
    this.scene.add(this.ground);

    this.busCore = new BusCore(this.sharedUniforms).build();
    this.scene.add(this.busCore);

    this.zones = ZONE_CONFIG.map(cfg => new Zone(cfg, this.sharedUniforms));
    this.zones.forEach(z => this.scene.add(z.root));

    this.attackZone = new AttackZone(this.sharedUniforms).build();
    this.scene.add(this.attackZone.root);

    this.fx = new FXManager(this.scene, this.sharedUniforms);
  }

  /** 外部调用：选手尝试解题 */
  onAttempt({ challengeId, team, teamColor }) {
    const node = this._findNode(challengeId);
    const zone = this._findZone(node.userData.zoneId);

    this.attackZone.launchOrb(team, teamColor, node, () => {
      const curve = buildAttackPath(node, zone);
      this.fx.spawnBeam({
        curve,
        color: STATE_COLOR.attacking,
        team,
        onArrive: () => {
          setChallengeState(node, 'attacking', { team });
          this.fx.spawnScanRing(node);
          this.fx.spawnChallengeCard(node, { team });
          zone.telemetry.threats += 1;
        }
      });
    });
  }

  /** 外部调用：提交 Flag 失败 */
  onFailed({ challengeId, team }) {
    const node = this._findNode(challengeId);
    const beam = this.fx.getBeamByTarget(challengeId);
    if (beam) {
      beam.setColor(STATE_COLOR.failed);
      beam.speedUp(0.15);
    }
    this.fx.onBeamArrive(challengeId, () => {
      this.fx.spawnShieldDome(node);          // 六边形护盾
      this.fx.spawnParticleBurst(node, 'failed');
      this.fx.spawnShockwave(node, 'failed');
      this.fx.spawnFloatText(node, 'ACCESS DENIED', '#ff3b5c');
      node.userData.flashFail();
      this._shakeCamera(0.12, 0.2);
      this.ground.spawnRipple(node.userData.zoneId, 0xff3b5c);
      this.fx.removeBeam(beam);
    });
  }

  /** 外部调用：提交 Flag 成功 */
  onSolved({ challengeId, team, score, firstBlood }) {
    const node = this._findNode(challengeId);
    const zone = this._findZone(node.userData.zoneId);
    const beam = this.fx.getBeamByTarget(challengeId);

    if (beam) {
      beam.setColor(STATE_COLOR.solved);
      beam.thicken(0.075, 0.2);
      beam.setIntensity(2.0);
      beam.speedUp(0.2);
    }

    this.fx.onBeamArrive(challengeId, () => {
      this.fx.spawnParticleBurst(node, 'solved');       // 粒子喷泉
      this.fx.spawnTripleShockwave(node);               // 三重冲击波
      this.fx.spawnDataReturn(beam.curve, node);        // 数据回流
      this.fx.spawnFloatText(this.attackZone.muzzle, `+${score}`, '#00ff88');
      setChallengeState(node, 'solved', { team, firstBlood });
      this.busCore.spawnCircularPulse(node.userData.zoneId, 0x00ff88);
      this.ground.spawnRipple(node.userData.zoneId, 0x00ff88);
      zone.telemetry.addScore(score);
      zone.telemetry.pulse();
      this.fx.removeBeam(beam);
    });
  }
}
```

### 14.2 攻击光束 Shader

```js
const beamVertex = /* glsl */`
  varying vec2 vUv;
  void main() {
    vUv = uv;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;

const beamFragment = /* glsl */`
  uniform float uTime;
  uniform float uProgress;    // 0 → 1，光束生长进度
  uniform float uIntensity;
  uniform vec3  uColor;
  varying vec2  vUv;

  void main() {
    // 沿管长的能量脉冲
    float flow = fract(vUv.x * 8.0 - uTime * 3.0);
    float pulse = pow(1.0 - abs(flow * 2.0 - 1.0), 6.0);

    // 头部高亮（uProgress 处）
    float head = smoothstep(uProgress - 0.04, uProgress, vUv.x)
               * smoothstep(uProgress + 0.02, uProgress, vUv.x);

    // 生长遮罩：uProgress 之前的才显示
    float grow = step(vUv.x, uProgress);

    // 管壁径向高光
    float rim = pow(1.0 - abs(vUv.y - 0.5) * 2.0, 2.0);

    float a = grow * (0.35 + pulse * 0.65 + head * 1.2) * rim;
    vec3 col = uColor * (1.0 + pulse * 1.5 + head * 4.0) * uIntensity;

    gl_FragColor = vec4(col, a);
  }
`;
```

### 14.3 探针沿曲线飞行

```js
update(dt) {
  if (this.arrived) return;

  this.progress += dt / this.duration;
  const t = Math.min(this.progress, 1.0);
  const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;

  // 探针位置
  this.curve.getPointAt(eased, this._tmpVec);
  this.probe.position.copy(this._tmpVec);
  this.probe.scale.setScalar(1 + Math.sin(eased * Math.PI) * 0.6);

  // 光束生长
  this.beamMat.uniforms.uProgress.value = eased;

  // 拖尾：把最近 8 帧的位置记录到一个 Line 的 BufferGeometry
  this._pushTrailPoint(this._tmpVec);

  if (t >= 1.0) {
    this.arrived = true;
    this.onArrive?.();
  }
}
```

