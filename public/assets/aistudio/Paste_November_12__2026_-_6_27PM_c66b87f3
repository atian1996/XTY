### 12.2 设备状态机

```
                 attempt
      ┌─────────────────────────────┐
      │                             ▼
   ┌─────┐   failed(无并发)      ┌───────────┐
   │idle │◄──────────────────────│ attacking │
   └─────┘                       └───────────┘
      ▲                                │
      │                                │ solved
      │            failed              ▼
      │        ┌────────────┐      ┌────────┐
      └────────┤  (闪烁态)   │      │ solved │
               └────────────┘      └────────┘
                     ▲                  │
                     └──────────────────┘
                    （solved 不可回退）
```

**状态变更函数：**

```js
function setChallengeState(node, nextState, payload = {}) {
  const prev = node.userData.state;
  if (prev === nextState) return;
  if (prev === 'solved') return;   // 已解不可回退

  node.userData.state = nextState;
  const targetColor = STATE_COLOR[nextState];

  // 启动 0.4s 颜色过渡（不直接赋值）
  tweenColor(node.userData.edges.material, targetColor, 0.4);
  tweenColor(node.userData.aura.material, targetColor, 0.4);
  tweenColor(node.userData.baseRing.material, targetColor, 0.4);

  // 各状态专属动画
  switch (nextState) {
    case 'attacking':
      node.userData.startScan();
      node.userData.beacon.material.opacity = 0.35;
      break;
    case 'solved':
      node.userData.stopScan();
      node.userData.beacon.material.opacity = 0.20;
      node.userData.playSolveBurst(payload.firstBlood);
      break;
  }

  // 铭牌重绘
  node.userData.label.userData.redraw(nextState, payload);
}
```

### 12.3 主循环（时钟驱动）

```js
const clock = new THREE.Clock();
let elapsed = 0;

function animate() {
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);   // 限制最大步长，防止切后台后跳变
  elapsed += dt;

  // 1) 全局统一时间 uniform 更新
  sharedUniforms.uTime.value = elapsed;

  // 2) 分区悬浮
  zones.forEach((z, i) => {
    z.platform.position.y = Math.sin(elapsed * 0.6 + i * 0.9) * 0.08;
  });

  // 3) 每台设备的状态动画
  allChallengeNodes.forEach(node => updateNode(node, dt, elapsed));

  // 4) 特效系统
  beamManager.update(dt);
  particlePool.update(dt);
  shockwavePool.update(dt);
  floatTextPool.update(dt);

  // 5) 攻击区光点公转
  attackZone.update(dt, elapsed);

  // 6) 控制器 + 后处理
  controls.update();
  composer.render();
}
```

